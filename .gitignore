# ==============================================================================
# ASR Feedback Intelligence Platform — .gitignore
# ==============================================================================

# ----- OS Generated Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Editor & IDE Files -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-workspace
*.sublime-project

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
package-lock.json
yarn.lock

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env
.venv
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.eggs/
dist/
build/

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.key
*.pem
*.cert
secrets/
credentials/

# ----- Logs -----
logs/
*.log

# ----- Data & Exports -----
# Never commit real client data
data/raw/
data/exports/
*.csv
*.xlsx
*.parquet
!schemas/examples/*.json

# ----- Build Outputs -----
dist/
build/
out/
*.min.js
*.min.css

# ----- Test Coverage -----
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*

# ----- Temporary Files -----
tmp/
temp/
*.tmp
*.bak
*.backup
